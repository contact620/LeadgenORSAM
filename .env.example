# Serper.dev API (LinkedIn search via Google index)
# Free tier: 2500 queries/month — https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Dropcontact API
DROPCONTACT_API_KEY=your_dropcontact_api_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity Sonar API (company enrichment: digital maturity, budget, signals)
# Get your key at https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Hunter.io API (email verification, Step 3c)
# Get your key at https://hunter.io/api-keys — ~$0.01 per verification
HUNTER_API_KEY=your_hunter_api_key_here

# LLM model for Step 6 AI enrichment (default: claude-sonnet-4-6)
# Other options: claude-haiku-4-5-20251001 (cheaper), claude-opus-4-7 (highest quality)
LLM_MODEL=claude-sonnet-4-6

# Paths
APOLLO_COOKIES_PATH=apollo_cookies.json

# Behavior
REQUEST_DELAY=2.0
HIT_THRESHOLD=50
DROPCONTACT_BATCH_SIZE=50
MAX_LEADS=500
