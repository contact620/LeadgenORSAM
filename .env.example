# Serper.dev API (LinkedIn search via Google index)
# Free tier: 2500 queries/month — https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Perplexity Sonar API (company enrichment: digital maturity, budget, signals)
# Get your key at https://perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Hunter.io API (email verification, Step 3c)
# Get your key at https://hunter.io/api-keys — ~$0.01 per verification
HUNTER_API_KEY=your_hunter_api_key_here

# Prospeo API (recherche d'email, cascade gratuite)
# Get your key at https://prospeo.io — 100 requêtes gratuites par mois
PROSPEO_API_KEY=your_prospeo_api_key_here

# GetProspect API (recherche + vérification d'email, cascade gratuite)
# Get your key at https://getprospect.com — 50 recherches + 100 vérifications gratuites par mois
GETPROSPECT_API_KEY=your_getprospect_api_key_here

# LLM model for Step 6 AI enrichment (default: claude-sonnet-4-6)
# Other options: claude-haiku-4-5-20251001 (cheaper), claude-opus-4-7 (highest quality)
LLM_MODEL=claude-sonnet-4-6

# Paths
APOLLO_COOKIES_PATH=apollo_cookies.json

# Behavior
REQUEST_DELAY=2.0
HIT_THRESHOLD=50
MAX_LEADS=500

# Quotas mensuels de la cascade email gratuite (Prospeo → GetProspect → Hunter)
# Valeurs par défaut du plan gratuit de chaque fournisseur ; resynchronisées
# automatiquement au démarrage de chaque run quand le fournisseur expose son
# solde réel. GetProspect a deux quotas indépendants : recherche et vérification.
PROSPEO_MONTHLY_ALLOCATION=100
HUNTER_MONTHLY_ALLOCATION=50
GETPROSPECT_MONTHLY_ALLOCATION=50
GETPROSPECT_VERIFY_ALLOCATION=100

# Report des crédits non consommés au mois suivant, en multiples de l'allocation
# (0 = aucun report). GetProspect reporte jusqu'à un mois d'allocation complet.
PROSPEO_ROLLOVER_CAP=0
HUNTER_ROLLOVER_CAP=0
GETPROSPECT_ROLLOVER_CAP=1
GETPROSPECT_VERIFY_ROLLOVER_CAP=1
